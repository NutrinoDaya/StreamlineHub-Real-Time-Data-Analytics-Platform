<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <DAG>
        <schedule_interval>@hourly</schedule_interval>
        <catchup>false</catchup>
        <retries>1</retries>
        <interval>24 hours</interval>
    </DAG>
    <Paths>
        <aggregation_script>dag_scripts/gold_aggregation.py</aggregation_script>
        <elastic_script>dag_scripts/elasticsearch_ingestion.py</elastic_script>
    </Paths>
    <Elasticsearch>
        <host>localhost</host>
        <port>9200</port>
        <index_prefix>streamlinehub</index_prefix>
    </Elasticsearch>
    <Spark>
        <master>spark://spark-master:7077</master>
        <executor_memory>2g</executor_memory>
        <executor_cores>2</executor_cores>
    </Spark>
</configuration>