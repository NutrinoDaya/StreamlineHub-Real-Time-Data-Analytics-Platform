# FastAPI Backend Dockerfile
FROM python:3.10.8-slim

# Set working directory
WORKDIR /app

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

# Install system dependencies including Java
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        build-essential \
        default-jdk-headless \
        && rm -rf /var/lib/apt/lists/*

# Set JAVA_HOME
ENV JAVA_HOME=/usr/lib/jvm/default-java
ENV PATH=$JAVA_HOME/bin:$PATH

# Copy requirements first for better Docker layer caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy and extract local Spark 3.5.4
COPY backend/dependencies/spark/spark-3.5.4-bin-hadoop3.tgz /tmp/
RUN cd /opt && \
    tar -xzf /tmp/spark-3.5.4-bin-hadoop3.tgz && \
    mv spark-3.5.4-bin-hadoop3 spark && \
    rm /tmp/spark-3.5.4-bin-hadoop3.tgz

# Set Spark environment variables
ENV SPARK_HOME=/opt/spark
ENV PATH=$SPARK_HOME/bin:$SPARK_HOME/sbin:$PATH
ENV PYSPARK_PYTHON=python3

# Copy application source code
COPY backend/src/ ./src/
COPY backend/models/ ./models/
COPY backend/scripts/ ./scripts/
COPY backend/config/ ./config/

# Create necessary directories
RUN mkdir -p /app/data /app/logs

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default command
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]